# Frontend settings. Copy to .env.local:   cp .env.example .env.local
# Get both from Supabase → Project Settings → API Keys (URL + "Publishable key").
# They end up in the browser bundle, so they are not secret; security comes from
# Row Level Security in the database. Placeholders only — never commit real values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Leave empty: locally Vite proxies /api to localhost:4000, and on Vercel the app
# and API share one domain. Only set it if the API runs on a different domain.
VITE_API_URL=
