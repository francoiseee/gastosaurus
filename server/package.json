{
  "name": "gastosaurus-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gastosaurus REST API (Express + Supabase Postgres)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
