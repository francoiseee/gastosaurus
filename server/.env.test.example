# `npm test` runs against a LOCAL throwaway Postgres (never Supabase) and a fake
# Supabase Auth server the tests start themselves. The DB name must contain "test".
NODE_ENV=test
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gastosaurus_test
DATABASE_SSL=false
SUPABASE_URL=http://localhost:54399
SUPABASE_PUBLISHABLE_KEY=sb_publishable_test
