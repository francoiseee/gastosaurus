# Copy to .env and fill in:   cp .env.example .env
NODE_ENV=development
PORT=4000

# Supabase → your project → "Connect" button → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with the database password
# (Project Settings → Database → Reset database password if you don't know it).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@[POOLER-HOST-FROM-DASHBOARD]:5432/postgres
DATABASE_SSL=true

SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (same one the frontend uses)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# The React dev server
CLIENT_ORIGIN=http://localhost:5173
